<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- robot as extracted via https://github.com/syuntoku14/fusion2urdf -->
    <xacro:macro name="iiwa14"
        params="robot_name:=^|lbr mode:=^|mock system_config_path:=^|'$(find lbr_description)/ros2_control/lbr_system_config.yaml'">

        <!-- includes -->
        <xacro:include filename="$(find lbr_description)/gazebo/lbr_gazebo.xacro" />
        <xacro:include filename="$(find lbr_description)/ros2_control/lbr_system_interface.xacro" />

        <!-- joint limits via yaml -->
        <xacro:property name="joint_limits_path"
            value="$(find lbr_description)/urdf/iiwa14/joint_limits.yaml" />
        <xacro:property name="joint_limits" value="${xacro.load_yaml(joint_limits_path)}" />

        <!-- constants -->
        <xacro:property name="PI" value="3.1415926535897931" />
        <xacro:property name="joint_damping" value="0.2" />
        <xacro:property name="joint_friction" value="0.2" />

        <!-- macros for gazebo / mock / hardware -->
        <xacro:lbr_gazebo robot_name="${robot_name}" />
        <xacro:lbr_system_interface
            robot_name="${robot_name}"
            mode="${mode}"
            joint_limits="${joint_limits}"
            system_config_path="${system_config_path}" />

        <material name="orange">
            <color rgba="0.949 0.360 0.098 1.0"/>
        </material>

        <material name="black">
            <color rgba="0. 0. 0. 1.0"/>
        </material>

        <material name="grey">
            <color rgba="0.7 0.7 0.7 1.0"/>
        </material>

        <material name="light_grey">
            <color rgba="0.87 0.87 0.87 1.0"/>
        </material>
        
        <link name="${robot_name}_link_0">
            <inertial>
                <origin rpy="0 0 0" xyz="-0.1 0 0.07"/>
                <mass value="5" />
                <inertia ixx="0.0333" iyy="0.033" izz="0.0123" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_0.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
        </link>

        <joint name="${robot_name}_A1" type="revolute">
            <origin rpy="0 0 0" xyz="0 0 0.1575" />
            <parent link="${robot_name}_link_0" />
            <child link="${robot_name}_link_1" />
            <axis xyz="0.0 0.0 1.0" />
            <limit
                effort="${joint_limits['A1']['effort']}"
                lower="${joint_limits['A1']['lower'] * PI / 180}"
                upper="${joint_limits['A1']['upper'] * PI / 180}"
                velocity="${joint_limits['A1']['velocity'] * PI / 180}" />
            <dynamics damping="0.2415" friction="0.31909" />
        </joint>

        <link name="${robot_name}_link_1">
            <inertial>
                <origin rpy="0 0 0" xyz="0 -0.03 0.12" />
                <mass value="5.76" />
                <inertia ixx="0.0333" iyy="0.033" izz="0.0123" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_1.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
        </link>

        <joint name="${robot_name}_A2" type="revolute">
            <origin rpy="${PI/2.0} 0 ${PI}" xyz="0 0 0.2025" />
            <parent link="${robot_name}_link_1" />
            <child link="${robot_name}_link_2" />
            <axis xyz="0.0 0.0 1.0" />
            <limit
                effort="${joint_limits['A2']['effort']}"
                lower="${joint_limits['A2']['lower'] * PI / 180}"
                upper="${joint_limits['A2']['upper'] * PI / 180}"
                velocity="${joint_limits['A2']['velocity'] * PI / 180}" />
            <dynamics damping="0.37328" friction="0.1813" />
        </joint>

        <link name="${robot_name}_link_2">
            <inertial>
                <origin rpy="0 0 0" xyz="0.0003 0.059 0.042" />
                <mass value="6.35" />
                <inertia ixx="0.0305" iyy="0.01100" izz="0.03040" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_2_grey.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_2_orange.obj" />
                </geometry>
                <material name="orange"/>
            </visual>
        </link>

        <joint name="${robot_name}_A3" type="revolute">
            <origin rpy="${PI/2.0} 0 ${PI}" xyz="0 0.2045 0" />
            <parent link="${robot_name}_link_2" />
            <child link="${robot_name}_link_3" />
            <axis xyz="0.0 0.0 1.0" />
            <limit
                effort="${joint_limits['A3']['effort']}"
                lower="${joint_limits['A3']['lower'] * PI / 180}"
                upper="${joint_limits['A3']['upper'] * PI / 180}"
                velocity="${joint_limits['A3']['velocity'] * PI / 180}" />
            <dynamics damping="0.11025" friction="0.07302" />
        </joint>

        <link name="${robot_name}_link_3">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0.03 0.13" />
                <mass value="3.5" />
                <inertia ixx="0.025" iyy="0.0238" izz="0.0076" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_3.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/band.obj" />
                </geometry>
                <material name="light_grey"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/kuka.obj" />
                </geometry>
                <material name="black"/>
            </visual>
        </link>

        <joint name="${robot_name}_A4" type="revolute">
            <origin rpy="${PI/2.0} 0 0" xyz="0 0 0.2155" />
            <parent link="${robot_name}_link_3" />
            <child link="${robot_name}_link_4" />
            <axis xyz="0.0 0.0 1.0"/>
            <limit
                effort="${joint_limits['A4']['effort']}"
                lower="${joint_limits['A4']['lower'] * PI / 180}"
                upper="${joint_limits['A4']['upper'] * PI / 180}"
                velocity="${joint_limits['A4']['velocity'] * PI / 180}" />
            <dynamics damping="0.1" friction="0.17671" />
        </joint>

        <link name="${robot_name}_link_4">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0.067 0.034" />
                <mass value="3.5" />
                <inertia ixx="0.017" iyy="0.00600" izz="0.01640" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_4_orange.obj" />
                </geometry>
                <material name="orange"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_4_grey.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
        </link>

        <joint name="${robot_name}_A5" type="revolute">
            <origin rpy="${PI / 2.0} 0 ${PI}" xyz="0 0.1845 0" />
            <parent link="${robot_name}_link_4" />
            <child link="${robot_name}_link_5" />
            <axis xyz="0.0 0.0 1.0" />
            <limit
                effort="${joint_limits['A5']['effort']}"
                lower="${joint_limits['A5']['lower'] * PI / 180}"
                upper="${joint_limits['A5']['upper'] * PI / 180}"
                velocity="${joint_limits['A5']['velocity'] * PI / 180}" />
            <dynamics damping="0.1" friction="0.03463" />
        </joint>

        <link name="${robot_name}_link_5">
            <inertial>
                <origin rpy="0 0 0" xyz="0.0001 0.021 0.076" />
                <mass value="3.5" />
                <inertia ixx="0.01" iyy="0.0087" izz="0.00449" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />  
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_5.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/band.obj" />
                </geometry>
                <material name="light_grey"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/kuka.obj" />
                </geometry>
                <material name="black"/>
            </visual>
        </link>

        <joint name="${robot_name}_A6" type="revolute">
            <origin rpy="${PI / 2.0} 0 0" xyz="0 0 0.2155" />
            <parent link="${robot_name}_link_5" />
            <child link="${robot_name}_link_6" />
            <axis xyz="0.0 0.0 1.0" />
            <limit
                effort="${joint_limits['A6']['effort']}"
                lower="${joint_limits['A6']['lower'] * PI / 180}"
                upper="${joint_limits['A6']['upper'] * PI / 180}"
                velocity="${joint_limits['A6']['velocity'] * PI / 180}" />
            <dynamics damping="0.12484" friction="0.13391" />
        </joint>

        <link name="${robot_name}_link_6">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0.0006 0.0004" />
                <mass value="1.8" />
                <inertia ixx="0.0049" iyy="0.00360" izz="0.00470" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_6_orange.obj" />
                </geometry>
                <material name="orange"/>
            </visual>
            <visual>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_6_grey.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
        </link>

        <joint name="${robot_name}_A7" type="revolute">
            <origin rpy="${PI/2.0} 0 ${PI}" xyz="0 0.081 0" />
            <parent link="${robot_name}_link_6" />
            <child link="${robot_name}_link_7" />
            <axis xyz="0.0 0.0 1.0" />
            <limit
                effort="${joint_limits['A7']['effort']}"
                lower="${joint_limits['A7']['lower'] * PI / 180}"
                upper="${joint_limits['A7']['upper'] * PI / 180}"
                velocity="${joint_limits['A7']['velocity'] * PI / 180}" />
            <dynamics damping="0.1" friction="0.0871" />
        </joint>

        <link name="${robot_name}_link_7">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0 0.02" />
                <mass value="1.2" />
                <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" ixz="0.0" iyz="0.0"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
                <geometry>
                    <mesh filename="package://lbr_description/meshes/iiwa14/mjctrl_mesh/link_7.obj" />
                </geometry>
                <material name="grey"/>
            </visual>
        </link>

        <joint name="${robot_name}_joint_ee" type="fixed">
            <parent link="${robot_name}_link_7" />
            <child link="${robot_name}_link_ee" />
            <origin xyz="0 0 0.045" rpy="0 0 0" />
        </joint>

        <link name="${robot_name}_link_ee">
        </link>
    </xacro:macro>
</robot>